# Copie para .env e preencha os valores
# NUNCA commite o .env no git

# ── CORS (pose-service, notification-service, Kong) ────────────────────────
# Em desenvolvimento: * (aceita qualquer origem)
# Em produção: lista separada por vírgula sem espaços
# Exemplo produção: CORS_ORIGINS=https://academia.com,https://app.academia.com
CORS_ORIGINS=*

# JWT
JWT_SECRET=troque-por-uma-chave-secreta-forte-minimo-32-caracteres
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# PostgreSQL
POSTGRES_USER=gymvision
POSTGRES_PASSWORD=gymvision123
POSTGRES_DB=gymvision_users

# Redis
REDIS_PASSWORD=gymvision123

# TF Serving
TF_SERVING_HOST=tf-serving
TF_SERVING_PORT=8500
MODEL_NAME=movenet_thunder
